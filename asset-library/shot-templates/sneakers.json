        "id": "flat-pair",
        "name": "双只组合图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "双只前后错位摆放，展示整体造型",
        "references": [
          "garment"
        ]
      },
      {
        "id": "flat-sole",
        "name": "鞋底图",
