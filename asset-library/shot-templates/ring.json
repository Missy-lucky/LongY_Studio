{
  "schema": "longy.shot-template.v1",
  "id": "ring-shot-v1",
  "category": "ring",
  "categoryName": "戒指",
  "group": "配饰",
  "version": "1.0.0",
  "updatedAt": "2026-10-11",
  "description": "戒指品类标准电商套图镜头清单。任务规划器按 shots 自动展开任务，按 conditionalShots 与商品属性自动加减镜头，导出前按模板做完整性校验。",
  "attributes": [
    {
      "key": "hasGem",
      "label": "镶嵌宝石",
      "type": "boolean",
      "default": true
    },
    {
      "key": "hasEngraving",
      "label": "刻字",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "正面商品图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "戒面正对镜头，镶嵌完整清晰",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张"
      },
      {
        "id": "flat-side",
        "name": "侧面商品图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "侧面展示戒壁与镶嵌高度",
        "references": [
          "garment"
        ]
      },
      {
        "id": "flat-angle",
        "name": "45度角商品图",
        "type": "flat",
        "required": false,
        "priority": "P1",
        "promptHints": "斜角立体展示",
        "references": [
          "garment"
        ]
      }
    ],
    "partial": [
      {
        "id": "partial-macro",
        "name": "微距形态图",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "微距立体结构",
        "references": [
          "garment"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-gem-setting",
        "name": "镶嵌正面特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "主石镶嵌工艺",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-side",
        "name": "侧面细节图",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "侧面戒壁与爪位",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-band",
        "name": "戒臂特写",
        "type": "detail",
        "required": false,
        "priority": "P1",
        "promptHints": "戒臂线条与副石",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-inside",
        "name": "内圈特写",
        "type": "detail",
        "required": false,
        "priority": "P2",
        "promptHints": "内圈刻字或工艺",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-finger-closeup",
        "name": "手指特写模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "手指佩戴特写，展示比例与光泽",
        "references": [
          "garment",
          "model-identity"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-hand-gesture",
        "name": "手势展示模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "自然手势中的佩戴效果",
        "references": [
          "garment",
          "model-identity"
        ]
      },
      {
        "id": "model-half-front",
        "name": "半身模特图",
        "type": "model",
        "required": false,
        "priority": "P2",
        "promptHints": "半身整体搭配",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "hasEngraving",
        "equals": true
      },
      "add": [
        {
          "id": "detail-engraving",
          "name": "刻字特写",
          "type": "detail",
          "required": true,
          "priority": "P0",
          "promptHints": "内圈或侧面刻字内容",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景搭配图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实使用场景，展示佩戴或使用状态"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕材质工艺卖点，预留文案排版空间"
    },
    {
      "id": "module-spec-chart",
      "name": "规格参数表",
      "priority": "P0",
      "generate": false,
      "note": "尺寸重量材质参数，用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "保养说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-gem-setting",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
