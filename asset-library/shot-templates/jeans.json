{
  "schema": "longy.shot-template.v1",
  "id": "jeans-shot-v1",
  "category": "jeans",
  "categoryName": "牛仔裤",
  "group": "下装",
  "version": "1.0.0",
  "updatedAt": "2026-10-11",
  "description": "牛仔裤品类标准电商套图镜头清单。任务规划器按 shots 自动展开任务，按 conditionalShots 与商品属性自动加减镜头，导出前按模板做完整性校验。",
  "attributes": [
    {
      "key": "isDistressed",
      "label": "破洞磨白",
      "type": "boolean",
      "default": false
    },
    {
      "key": "hasEmbroidery",
      "label": "刺绣",
      "type": "boolean",
      "default": false
    },
    {
      "key": "isWideLeg",
      "label": "阔腿",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "正面平铺图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "正面完整平铺，左右对称，纯白背景，四周留白充足",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张，详情页首屏"
      },
      {
        "id": "flat-back",
        "name": "背面平铺图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "背面完整平铺，与正面同比例同构图",
        "references": [
          "garment"
        ],
        "platformUse": "详情页版型结构屏"
      }
    ],
    "partial": [
      {
        "id": "partial-hanging-front",
        "name": "正面悬挂展示图",
        "type": "partial",
        "required": true,
        "priority": "P0",
        "promptHints": "裤腿自然垂坠，展示裤型",
        "references": [
          "garment",
          "style"
        ]
      },
      {
        "id": "partial-hanging-side",
        "name": "侧面悬挂展示图",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "侧面悬挂，展示裤腿弧度",
        "references": [
          "garment",
          "style"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-waistband",
        "name": "腰头特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "腰头双线与裤袢",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-pocket",
        "name": "裤袋特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "前后口袋造型与装饰线",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-rivet",
        "name": "铆钉特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "铆钉与扣件五金",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-hem",
        "name": "裤脚特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "裤脚卷边或磨边处理",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-fabric",
        "name": "水洗纹理特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "微距展示水洗做旧与棉质斜纹",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-stitch",
        "name": "装饰车线特写",
        "type": "detail",
        "required": false,
        "priority": "P1",
        "promptHints": "撞色车线走向",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-front-full",
        "name": "正面全身模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "正面站姿，展示裤型与腰线",
        "references": [
          "garment",
          "model-identity",
          "style"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-back-full",
        "name": "背面全身模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "背面站姿，展示后袋位置",
        "references": [
          "garment"
        ]
      },
      {
        "id": "model-side-full",
        "name": "侧面全身模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "侧面站姿，展示裤腿弧度",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      },
      {
        "id": "model-walking",
        "name": "行走动态模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "行走中展示裤腿动感",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      },
      {
        "id": "model-sitting",
        "name": "坐姿模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "坐姿展示膝盖处版型",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      },
      {
        "id": "model-hem-closeup",
        "name": "裤脚特写模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "裤脚与鞋面衔接和堆叠感",
        "references": [
          "garment",
          "model-identity"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "isDistressed",
        "equals": true
      },
      "add": [
        {
          "id": "detail-distress",
          "name": "破洞磨白特写",
          "type": "detail",
          "required": true,
          "priority": "P0",
          "promptHints": "破洞位置与磨白渐变",
          "references": [
            "garment"
          ]
        }
      ]
    },
    {
      "when": {
        "attribute": "hasEmbroidery",
        "equals": true
      },
      "add": [
        {
          "id": "detail-embroidery",
          "name": "刺绣特写",
          "type": "detail",
          "required": true,
          "priority": "P0",
          "promptHints": "刺绣针法与图案",
          "references": [
            "garment"
          ]
        }
      ]
    },
    {
      "when": {
        "attribute": "isWideLeg",
        "equals": true
      },
      "add": [
        {
          "id": "model-wide-hem",
          "name": "阔腿摆动模特图",
          "type": "model",
          "required": false,
          "priority": "P1",
          "promptHints": "阔腿裤脚随步伐摆动",
          "references": [
            "garment",
            "model-identity",
            "style"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景生活图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实生活场景，模特与环境自然互动"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕核心卖点，预留文案排版空间"
    },
    {
      "id": "module-size-chart",
      "name": "尺码表",
      "priority": "P0",
      "generate": false,
      "note": "按平台规格用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "洗护说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-fabric",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
