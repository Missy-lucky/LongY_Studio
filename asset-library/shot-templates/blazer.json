{
  "schema": "longy.shot-template.v1",
  "id": "blazer-shot-v1",
  "category": "blazer",
  "categoryName": "西装",
  "group": "上装",
  "version": "1.1.0",
  "updatedAt": "2026-10-16",
  "description": "西装品类标准电商套图镜头清单。任务规划器按 shots 自动展开任务，按 conditionalShots 与商品属性自动加减镜头，导出前按模板做完整性校验。",
  "attributes": [
    {
      "key": "hasPinstripe",
      "label": "条纹",
      "type": "boolean",
      "default": false
    },
    {
      "key": "isDoubleBreasted",
      "label": "双排扣",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
