  "conditionalShots": [
    {
      "when": {
        "attribute": "hasPinstripe",
        "equals": true
      },
      "add": [
        {
          "id": "detail-stripe",
          "name": "条纹纹理特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "条纹对格与织纹",
          "references": [
            "garment"
          ]
        }
      ]
    },
    {
      "when": {
        "attribute": "isDoubleBreasted",
        "equals": true
      },
      "add": [
        {
          "id": "detail-double-breasted",
          "name": "双排扣特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "双排扣间距与排布",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景生活图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实生活场景，模特与环境自然互动"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕核心卖点，预留文案排版空间"
    },
    {
      "id": "module-size-chart",
      "name": "尺码表",
      "priority": "P0",
      "generate": false,
      "note": "按平台规格用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "洗护说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-fabric",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
