        "name": "正面平铺图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "正面完整平铺，双袖对称展开，纯白背景，四周留白充足",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张，详情页首屏"
      },
      {
        "id": "flat-back",
        "name": "背面平铺图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "背面完整平铺，与正面同比例同构图",
        "references": [
