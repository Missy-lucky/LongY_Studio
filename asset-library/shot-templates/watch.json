{
  "schema": "longy.shot-template.v1",
  "id": "watch-shot-v1",
  "category": "watch",
  "categoryName": "手表",
  "group": "配饰",
  "version": "1.0.0",
  "updatedAt": "2026-10-11",
  "description": "手表品类标准电商套图镜头清单。任务规划器按 shots 自动展开任务，按 conditionalShots 与商品属性自动加减镜头，导出前按模板做完整性校验。",
  "attributes": [
    {
      "key": "isSmart",
      "label": "智能手表",
      "type": "boolean",
      "default": false
    },
    {
      "key": "hasMetalStrap",
      "label": "金属表带",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "表盘正面图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "表盘正面对焦清晰，指针或屏幕完整",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张"
      },
      {
        "id": "flat-side",
        "name": "侧面厚度图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "侧面展示表壳厚度与表冠",
        "references": [
          "garment"
        ]
      },
      {
        "id": "flat-clasp",
        "name": "表扣展开图",
        "type": "flat",
        "required": false,
        "priority": "P1",
        "promptHints": "表带与表扣展开形态",
        "references": [
          "garment"
        ]
      }
    ],
    "partial": [
      {
        "id": "partial-wrist-gesture",
        "name": "手腕姿势图",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "抬腕姿势，展示佩戴角度",
        "references": [
          "garment",
          "style"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-dial",
        "name": "表盘特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "刻度指针或屏幕细节",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-strap",
        "name": "表带特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "表带材质与纹理",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-clasp",
        "name": "表扣特写",
        "type": "detail",
        "required": false,
        "priority": "P1",
        "promptHints": "表扣结构与开合",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-crown",
        "name": "表冠特写",
        "type": "detail",
        "required": false,
        "priority": "P2",
        "promptHints": "表冠细节",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-wrist-closeup",
        "name": "手腕特写模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "手腕佩戴特写，展示比例",
        "references": [
          "garment",
          "model-identity"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-half-front",
        "name": "半身模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "商务或休闲半身搭配",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "isSmart",
        "equals": true
      },
      "add": [
        {
          "id": "detail-smart-ui",
          "name": "功能界面特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "表盘功能界面显示",
          "references": [
            "garment"
          ]
        }
      ]
    },
    {
      "when": {
        "attribute": "hasMetalStrap",
        "equals": true
      },
      "add": [
        {
          "id": "detail-strap-link",
          "name": "链节调节特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "金属链节与调节结构",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景搭配图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实使用场景，展示佩戴或使用状态"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕材质工艺卖点，预留文案排版空间"
    },
    {
      "id": "module-spec-chart",
      "name": "规格参数表",
      "priority": "P0",
      "generate": false,
      "note": "尺寸重量材质参数，用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "保养说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-dial",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
