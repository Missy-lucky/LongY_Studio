{
  "schema": "longy.shot-template.v1",
  "id": "jacket-shot-v1",
  "category": "jacket",
  "categoryName": "夹克",
  "group": "上装",
  "version": "1.1.0",
  "updatedAt": "2026-10-16",
  "description": "夹克二级品类标准电商套图镜头清单。",
  "attributes": [
    {
      "key": "hasZipper",
      "label": "拉链",
      "type": "boolean",
      "default": true
    },
    {
      "key": "hasPocket",
      "label": "口袋",
      "type": "boolean",
      "default": true
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "正面平铺图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "正面完整平铺，双袖对称展开，纯白背景，四周留白充足",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张，详情页首屏"
      },
      {
        "id": "flat-back",
        "name": "背面平铺图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "背面完整平铺，与正面同比例同构图",
        "references": [
          "garment"
        ],
        "platformUse": "详情页版型结构屏"
      }
    ],
    "partial": [
      {
        "id": "partial-worn-1",
        "name": "夹克模特穿搭·上半身正面穿着特写",
        "type": "partial",
        "required": true,
        "priority": "P0",
        "promptHints": "模特真实穿着或佩戴夹克，紧裁到商品区域，重点呈现上半身正面穿着；保留必要的人体连接与自然姿态，商品完整清晰，不从全身成图裁切放大",
        "references": [
          "garment",
          "model-identity"
        ]
      },
      {
        "id": "partial-worn-2",
        "name": "夹克模特穿搭·上半身背面穿着特写",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "模特真实穿着或佩戴夹克，紧裁到商品区域，重点呈现上半身背面穿着；保留必要的人体连接与自然姿态，商品完整清晰，不从全身成图裁切放大",
        "references": [
          "garment",
          "model-identity"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-lapel",
        "name": "翻领特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "翻领结构与走线",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-button",
        "name": "纽扣特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "纽扣材质与扣眼工艺",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-pocket",
        "name": "口袋特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "口袋位置与袋盖结构",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-fabric",
        "name": "面料纹理特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "微距展示呢料或纤维质感",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-front-full",
        "name": "正面全身模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "正面站姿，双手自然下垂，全身入镜，表情自然，纯白棚拍背景",
        "references": [
          "garment",
          "model-identity",
          "style"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-back-full",
        "name": "背面全身模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "背面站姿，展示背部版型",
        "references": [
          "garment"
        ]
      },
      {
        "id": "model-side-full",
        "name": "侧面全身模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "侧面站姿，展示侧轮廓与厚度",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      },
      {
        "id": "model-walking",
        "name": "行走动态模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "自然行走动态，衣摆随动作微动",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      },
      {
        "id": "model-upper-closeup",
        "name": "上半身特写模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "取面部到腰部，展示领口与搭配关系",
        "references": [
          "garment",
          "model-identity"
        ]
      },
      {
        "id": "model-sitting",
        "name": "坐姿场景模特图",
        "type": "model",
        "required": false,
        "priority": "P2",
        "promptHints": "休闲坐姿，适合场景化详情页",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      },
      {
        "id": "model-open-front",
        "name": "敞开正面全身模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "敞开衣襟正面站姿，展示内搭层次",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "hasZipper",
        "equals": true
      },
      "add": [
        {
          "id": "detail-zipper",
          "name": "拉链特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "严格依据商品原图展示拉链结构与工艺，不添加不存在的细节",
          "references": [
            "garment"
          ]
        }
      ]
    },
    {
      "when": {
        "attribute": "hasPocket",
        "equals": true
      },
      "add": [
        {
          "id": "detail-pocket-conditional",
          "name": "口袋特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "严格依据商品原图展示口袋结构与工艺，不添加不存在的细节",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景生活图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实生活场景，模特与环境自然互动"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕核心卖点，预留文案排版空间"
    },
    {
      "id": "module-size-chart",
      "name": "尺码表",
      "priority": "P0",
      "generate": false,
      "note": "按平台规格用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "洗护说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-fabric",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
