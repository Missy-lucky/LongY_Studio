{
  "schema": "longy.shot-template.v1",
  "id": "bracelet-shot-v1",
  "category": "bracelet",
  "categoryName": "手链",
  "group": "配饰",
  "version": "1.1.0",
  "updatedAt": "2026-10-16",
  "description": "手链品类标准电商套图镜头清单。任务规划器按 shots 自动展开任务，按 conditionalShots 与商品属性自动加减镜头，导出前按模板做完整性校验。",
  "attributes": [
    {
      "key": "hasCharm",
      "label": "吊饰",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "平铺全景图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "手链完整平铺成弧线",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张"
      },
      {
        "id": "flat-macro",
        "name": "微距细节图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "链节与材质微距",
        "references": [
          "garment"
        ]
      }
    ],
    "partial": [
      {
        "id": "partial-macro",
        "name": "手链模特穿搭·微距特写",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "模特真实穿着或佩戴手链，紧裁到商品区域，重点呈现微距；保留必要的人体连接与自然姿态，商品完整清晰，不从全身成图裁切放大",
        "references": [
          "garment",
          "model-identity"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-links",
        "name": "链节特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "链节连接与光泽",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-clasp",
        "name": "扣头特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "扣头开合结构",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-material",
        "name": "材质特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "金属或宝石材质细节",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-wrist-closeup",
        "name": "手腕特写模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "手腕佩戴特写",
        "references": [
          "garment",
          "model-identity"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-hand-action",
        "name": "手部动作模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "自然手部动作中的佩戴效果",
        "references": [
          "garment",
          "model-identity"
        ]
      },
      {
        "id": "model-half-front",
        "name": "半身模特图",
        "type": "model",
        "required": false,
        "priority": "P2",
        "promptHints": "半身整体搭配",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "hasCharm",
        "equals": true
      },
      "add": [
        {
          "id": "detail-charm",
          "name": "吊饰特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "吊饰造型与连接",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景搭配图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实使用场景，展示佩戴或使用状态"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕材质工艺卖点，预留文案排版空间"
    },
    {
      "id": "module-spec-chart",
      "name": "规格参数表",
      "priority": "P0",
      "generate": false,
      "note": "尺寸重量材质参数，用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "保养说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-links",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
