{
  "schema": "longy.shot-template.v1",
  "id": "silkScarf-shot-v1",
  "category": "silkScarf",
  "categoryName": "丝巾",
  "group": "配饰",
  "version": "1.1.0",
  "updatedAt": "2026-10-16",
  "description": "丝巾二级品类标准电商套图镜头清单。",
  "attributes": [
    {
      "key": "hasPrint",
      "label": "印花",
      "type": "boolean",
      "default": true
    },
    {
      "key": "hasRolledHem",
      "label": "手工卷边",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "完整展开图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "丝巾完整展开平铺，展示整体图案",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张"
      },
      {
        "id": "flat-folded",
        "name": "折叠摆放图",
        "type": "flat",
        "required": false,
        "priority": "P1",
        "promptHints": "折叠摆放展示厚度",
        "references": [
          "garment"
        ]
      }
    ],
    "partial": [
      {
        "id": "partial-worn-1",
        "name": "丝巾模特穿搭·颈部系法佩戴特写",
        "type": "partial",
        "required": true,
        "priority": "P0",
        "promptHints": "模特真实穿着或佩戴丝巾，紧裁到商品区域，重点呈现颈部系法佩戴；保留必要的人体连接与自然姿态，商品完整清晰，不从全身成图裁切放大",
        "references": [
          "garment",
          "model-identity"
        ]
      },
      {
        "id": "partial-worn-2",
        "name": "丝巾模特穿搭·肩颈垂坠佩戴特写",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "模特真实穿着或佩戴丝巾，紧裁到商品区域，重点呈现肩颈垂坠佩戴；保留必要的人体连接与自然姿态，商品完整清晰，不从全身成图裁切放大",
        "references": [
          "garment",
          "model-identity"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-texture",
        "name": "纹理特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "微距展示面料纹理",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-fringe",
        "name": "流苏特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "流苏密度与手工细节",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-weave",
        "name": "织法特写",
        "type": "detail",
        "required": false,
        "priority": "P1",
        "promptHints": "织法组织结构",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-neck-front",
        "name": "颈部正面佩戴模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "正面颈部系法",
        "references": [
          "garment",
          "model-identity"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-neck-side",
        "name": "颈部侧面佩戴模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "侧面佩戴层次",
        "references": [
          "garment",
          "model-identity"
        ]
      },
      {
        "id": "model-half-front",
        "name": "半身正面模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "半身整体搭配",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      },
      {
        "id": "model-second-tying",
        "name": "第二种系法模特图",
        "type": "model",
        "required": false,
        "priority": "P2",
        "promptHints": "换一种系法的佩戴效果",
        "references": [
          "garment",
          "model-identity"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "hasPrint",
        "equals": true
      },
      "add": [
        {
          "id": "detail-print",
          "name": "印花特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "严格依据商品原图展示印花结构与工艺，不添加不存在的细节",
          "references": [
            "garment"
          ]
        }
      ]
    },
    {
      "when": {
        "attribute": "hasRolledHem",
        "equals": true
      },
      "add": [
        {
          "id": "detail-rolledhem",
          "name": "手工卷边特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "严格依据商品原图展示手工卷边结构与工艺，不添加不存在的细节",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景搭配图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实使用场景，展示佩戴或使用状态"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕材质工艺卖点，预留文案排版空间"
    },
    {
      "id": "module-spec-chart",
      "name": "规格参数表",
      "priority": "P0",
      "generate": false,
      "note": "尺寸重量材质参数，用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "保养说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-texture",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
