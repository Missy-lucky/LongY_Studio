{
  "schema": "longy.shot-template.v1",
  "id": "sunglasses-shot-v1",
  "category": "sunglasses",
  "categoryName": "墨镜",
  "group": "配饰",
  "version": "1.1.0",
  "updatedAt": "2026-10-16",
  "description": "墨镜品类标准电商套图镜头清单。任务规划器按 shots 自动展开任务，按 conditionalShots 与商品属性自动加减镜头，导出前按模板做完整性校验。",
  "attributes": [
    {
      "key": "isPolarized",
      "label": "偏光镜片",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "正面商品图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "镜框正面完整展示",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张"
      },
      {
        "id": "flat-side",
        "name": "侧面商品图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "侧面镜腿与镜框弧度",
        "references": [
          "garment"
        ]
      },
      {
        "id": "flat-open",
        "name": "展开摆放图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "镜腿展开的三维形态",
        "references": [
          "garment"
        ]
      }
    ],
    "partial": [
      {
        "id": "partial-macro",
        "name": "墨镜模特穿搭·微距特写",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "模特真实穿着或佩戴墨镜，紧裁到商品区域，重点呈现微距；保留必要的人体连接与自然姿态，商品完整清晰，不从全身成图裁切放大",
        "references": [
          "garment",
          "model-identity"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-lens",
        "name": "镜片特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "镜片镀膜与通透度",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-frame",
        "name": "镜框特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "镜框材质与设计线条",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-temple",
        "name": "镜腿特写",
        "type": "detail",
        "required": false,
        "priority": "P1",
        "promptHints": "镜腿材质与脚套",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-hinge",
        "name": "铰链特写",
        "type": "detail",
        "required": false,
        "priority": "P2",
        "promptHints": "铰链开合结构",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-face-front",
        "name": "面部正面模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "模特面部正面佩戴",
        "references": [
          "garment",
          "model-identity"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-face-side",
        "name": "面部侧面模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "面部侧面佩戴轮廓",
        "references": [
          "garment",
          "model-identity"
        ]
      },
      {
        "id": "model-half-front",
        "name": "半身模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "半身整体造型",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "isPolarized",
        "equals": true
      },
      "add": [
        {
          "id": "detail-polarized",
          "name": "偏光效果示意",
          "type": "detail",
          "required": false,
          "priority": "P2",
          "promptHints": "偏光镜片效果示意",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景搭配图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实使用场景，展示佩戴或使用状态"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕材质工艺卖点，预留文案排版空间"
    },
    {
      "id": "module-spec-chart",
      "name": "规格参数表",
      "priority": "P0",
      "generate": false,
      "note": "尺寸重量材质参数，用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "保养说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-lens",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
