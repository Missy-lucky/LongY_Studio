{
  "schema": "longy.shot-template.v1",
  "id": "belt-shot-v1",
  "category": "belt",
  "categoryName": "腰带",
  "group": "配饰",
  "version": "1.1.0",
  "updatedAt": "2026-10-16",
  "description": "腰带品类标准电商套图镜头清单。任务规划器按 shots 自动展开任务，按 conditionalShots 与商品属性自动加减镜头，导出前按模板做完整性校验。",
  "attributes": [
    {
      "key": "isLeather",
      "label": "真皮",
      "type": "boolean",
      "default": true
    },
    {
      "key": "hasAutoBuckle",
      "label": "自动扣",
      "type": "boolean",
      "default": false
    }
  ],
  "defaults": {
    "tier": "draft",
    "outputByType": {
      "flat": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "partial": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      },
      "detail": {
        "width": 1536,
        "height": 1536,
        "background": "white"
      },
      "model": {
        "width": 1152,
        "height": 1536,
        "background": "white"
      }
    },
    "referenceRoles": {
      "garment": "商品原始图，结构与颜色的唯一权威来源",
      "model-identity": "v2 定稿模特身份参考，锁定脸型与身形",
      "style": "商业展示风格参考，只借构图与光线，不借人和衣服"
    }
  },
  "shots": {
    "flat": [
      {
        "id": "flat-front",
        "name": "平铺全景图",
        "type": "flat",
        "required": true,
        "priority": "P0",
        "promptHints": "皮带完整平铺成圈或直线，展示整体长度",
        "references": [
          "garment"
        ],
        "platformUse": "主图第1张"
      },
      {
        "id": "flat-rolled",
        "name": "卷起形态图",
        "type": "flat",
        "required": false,
        "priority": "P1",
        "promptHints": "卷起摆放的收纳形态",
        "references": [
          "garment"
        ]
      }
    ],
    "partial": [
      {
        "id": "partial-through-pants",
        "name": "腰带模特穿搭·穿扣特写",
        "type": "partial",
        "required": false,
        "priority": "P1",
        "promptHints": "模特真实穿着或佩戴腰带，紧裁到商品区域，重点呈现穿扣；保留必要的人体连接与自然姿态，商品完整清晰，不从全身成图裁切放大",
        "references": [
          "garment",
          "model-identity"
        ]
      }
    ],
    "detail": [
      {
        "id": "detail-buckle",
        "name": "扣头特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "扣头造型与五金光泽",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-grain",
        "name": "皮纹特写",
        "type": "detail",
        "required": true,
        "priority": "P0",
        "promptHints": "皮革粒面与质感",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-holes",
        "name": "孔位特写",
        "type": "detail",
        "required": false,
        "priority": "P1",
        "promptHints": "孔位间距与封边",
        "references": [
          "garment"
        ]
      },
      {
        "id": "detail-edge",
        "name": "边缘油边特写",
        "type": "detail",
        "required": false,
        "priority": "P1",
        "promptHints": "边缘油边工艺",
        "references": [
          "garment"
        ]
      }
    ],
    "model": [
      {
        "id": "model-waist-closeup",
        "name": "腰部系带特写模特图",
        "type": "model",
        "required": true,
        "priority": "P0",
        "promptHints": "腰部系带特写，展示与裤装的搭配",
        "references": [
          "garment",
          "model-identity"
        ],
        "platformUse": "主图第2张"
      },
      {
        "id": "model-full-front",
        "name": "正面全身模特图",
        "type": "model",
        "required": false,
        "priority": "P1",
        "promptHints": "全身展示腰带在整体造型中的位置",
        "references": [
          "garment",
          "model-identity",
          "style"
        ]
      }
    ]
  },
  "conditionalShots": [
    {
      "when": {
        "attribute": "hasAutoBuckle",
        "equals": true
      },
      "add": [
        {
          "id": "detail-auto-buckle",
          "name": "自动扣结构特写",
          "type": "detail",
          "required": false,
          "priority": "P1",
          "promptHints": "自动扣开合结构",
          "references": [
            "garment"
          ]
        }
      ]
    }
  ],
  "detailPageModules": [
    {
      "id": "module-scene",
      "name": "场景搭配图",
      "priority": "P1",
      "generate": true,
      "promptHints": "真实使用场景，展示佩戴或使用状态"
    },
    {
      "id": "module-selling-points",
      "name": "卖点图",
      "priority": "P0",
      "generate": true,
      "promptHints": "围绕材质工艺卖点，预留文案排版空间"
    },
    {
      "id": "module-spec-chart",
      "name": "规格参数表",
      "priority": "P0",
      "generate": false,
      "note": "尺寸重量材质参数，用设计模板输出，不走AI生图"
    },
    {
      "id": "module-care",
      "name": "保养说明",
      "priority": "P2",
      "generate": false,
      "note": "固定设计模板"
    }
  ],
  "platformPresets": {
    "taobao": {
      "mainImages": [
        "flat-front",
        "model-front-full",
        "detail-buckle",
        "module-scene",
        "module-selling-points"
      ],
      "minSize": "800x800",
      "recommendedSize": "1200x1200"
    }
  }
}
