{
  "name": "longy-studio-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "concurrently \"npm run vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron": "electron .",
    "dist": "cross-env LONGY_BUILD_OUT_DIR=dist npm run build && electron-builder --win",
    "predist": "node scripts/prepare-desktop.mjs",
    "postdist": "node scripts/cleanup-desktop.mjs"
  },
  "build": {
    "appId": "com.longy.studio",
    "productName": "LongY Studio",
    "directories": {
      "output": "../temp/build/release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "desktop-electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "description": "LongY Studio apparel ecommerce AI image workflow workbench",
  "author": "LongY Studio"
}
